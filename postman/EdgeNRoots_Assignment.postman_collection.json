{
  "info": {
    "_postman_id": "edgenroots-insurance-accounting",
    "name": "EdgeNRoots Insurance Accounting API",
    "description": "All endpoints for the Insurance Policy & Accounting Module. baseUrl variable = http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "POST /customers — valid",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amit Sharma\",\n  \"email\": \"amit@example.com\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] }
          }
        },
        {
          "name": "POST /customers — duplicate email (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amit Sharma\",\n  \"email\": \"amit@example.com\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] }
          }
        },
        {
          "name": "POST /customers — invalid email (expect 422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Email\",\n  \"email\": \"not-an-email\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] }
          }
        }
      ]
    },
    {
      "name": "Policies",
      "item": [
        {
          "name": "POST /policies — valid (10,000 + 18% GST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 1,\n  \"policy_number\": \"POL-2026-0002\",\n  \"premium\": 10000,\n  \"gst_rate\": 18,\n  \"start_date\": \"2026-09-01\",\n  \"end_date\": \"2027-08-31\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/policies", "host": ["{{baseUrl}}"], "path": ["policies"] }
          }
        },
        {
          "name": "POST /policies — duplicate policy number (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 1,\n  \"policy_number\": \"POL-2026-0002\",\n  \"premium\": 10000,\n  \"gst_rate\": 18,\n  \"start_date\": \"2026-09-01\",\n  \"end_date\": \"2027-08-31\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/policies", "host": ["{{baseUrl}}"], "path": ["policies"] }
          }
        },
        {
          "name": "POST /policies — unknown customer (expect 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 999,\n  \"policy_number\": \"POL-2026-0099\",\n  \"premium\": 10000,\n  \"gst_rate\": 18,\n  \"start_date\": \"2026-09-01\",\n  \"end_date\": \"2027-08-31\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/policies", "host": ["{{baseUrl}}"], "path": ["policies"] }
          }
        },
        {
          "name": "GET /policies/:id — detail + outstanding",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/policies/:id",
              "host": ["{{baseUrl}}"],
              "path": ["policies", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
        {
          "name": "GET /policies/:id/ledger — full audit trail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/policies/:id/ledger",
              "host": ["{{baseUrl}}"],
              "path": ["policies", ":id", "ledger"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
        {
          "name": "GET /policies/:id/summary — derived balances",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/policies/:id/summary",
              "host": ["{{baseUrl}}"],
              "path": ["policies", ":id", "summary"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "POST /payments — valid partial (5,900)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy_id\": 1,\n  \"amount\": 5900,\n  \"payment_date\": \"2026-09-06\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        },
        {
          "name": "POST /payments — overpayment (expect 422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy_id\": 1,\n  \"amount\": 999999,\n  \"payment_date\": \"2026-09-06\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        },
        {
          "name": "POST /payments — unknown policy (expect 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy_id\": 999,\n  \"amount\": 100,\n  \"payment_date\": \"2026-09-06\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        },
        {
          "name": "POST /payments — zero/negative amount (expect 422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy_id\": 1,\n  \"amount\": -5,\n  \"payment_date\": \"2026-09-06\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        }
      ]
    }
  ]
}
